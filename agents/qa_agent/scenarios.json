  {"id": "search_uppercase", "method": "GET", "path": "/items",
   "params": {"q": "APPLE"}, "expect": {"status": 200, "contains": "Apple Pie"}},
  {"id": "echo", "method": "GET", "path": "/echo",
   "params": {"msg": "hello"}, "expect": {"status": 200, "body_is": "hello"}}
